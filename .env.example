# WadiTech Academy — environment variables. Copy to .env.local (never commit real values).
# For the local docker-free stack, `npm run env:local` generates a working .env.local.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Use a NEW, isolated Supabase project for development/staging — never the existing production project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for verified payment updates and a few admin tasks. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
APP_ENV=development            # development | staging | production

# Payments: "sandbox" (simulated, default) or "hyperpay" (HyperPay test endpoint until approved)
PAYMENTS_PROVIDER=sandbox
PAYMENTS_SANDBOX_SECRET=       # >=16 random chars
HYPERPAY_BASE_URL=https://eu-test.oppwa.com
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_ENTITY_ID_VISA_MASTER=
HYPERPAY_WEBHOOK_KEY=          # hex key from HyperPay for encrypted webhook notifications
HYPERPAY_LIVE_ENABLED=false    # must stay false until the academy approves live billing

# AI assistant: "local" (free, retrieval over published course content) | "anthropic" | "openai"
# Media storage: local (development only, writes public/uploads) | supabase (Storage bucket "media")
STORAGE_DRIVER=local

AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=30
AI_PAID_ENABLED=false          # paid providers are refused unless this is true (requires approval)

# Email notifications: none (default, emails stay queued) | smtp | resend
EMAIL_PROVIDER=none
EMAIL_FROM=WadiTech Academy <no-reply@waditech.co>
SMTP_URL=                      # smtp://user:pass@host:587 (when EMAIL_PROVIDER=smtp)
RESEND_API_KEY=                # when EMAIL_PROVIDER=resend
CRON_SECRET=                   # >=16 random chars; schedulers call /api/cron/notifications with "Authorization: Bearer <CRON_SECRET>"

# Local stack only: captured email inbox
DEV_MAIL_URL=http://127.0.0.1:54321/__mail
