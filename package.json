{
  "name": "waditech-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "stack:setup": "bash scripts/local-stack/stack.sh setup",
    "stack:start": "bash scripts/local-stack/stack.sh start",
    "stack:stop": "bash scripts/local-stack/stack.sh stop",
    "stack:status": "bash scripts/local-stack/stack.sh status",
    "env:local": "node scripts/local-stack/gen-env.mjs",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:reset": "node scripts/db/migrate.mjs --reset --seed",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "marked": "^18.1.3",
    "next": "16.2",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4.3.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2",
    "mailparser": "^3.14.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "smtp-server": "^3.21.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
